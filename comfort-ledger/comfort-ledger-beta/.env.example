# ─────────────────────────────────────────────────────────────────────────────
# Comfort Ledger — variables de entorno
# Copia este archivo como .env y rellena los valores antes de arrancar.
# Nunca subas .env al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

PORT=8787
NODE_ENV=development
# Genera un secreto fuerte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COMFORT_SESSION_SECRET=change-me-to-a-long-random-string
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Máximo de tokens de salida por respuesta del coach (/api/ai-coach, streaming y JSON). Defecto 450 (#19).
OPENAI_COACH_MAX_TOKENS=450

COMFORT_SUBSCRIBE_URL=https://your-site.com/subscribe
# beta | onboarding | hybrid — hybrid: onboarding con comprobación Lemon (si configurado) + acceso testers vía login beta
COMFORT_ACCESS_MODE=beta
# Obliga correo con suscripción activa al onboarding (por defecto: sólo en modo hybrid cuando LS está configurado).
# Pon "false" para permitir onboarding sin comprobar pago incluso en hybrid.
# COMFORT_ONBOARDING_REQUIRES_SUBSCRIPTION=
# Visitantes sin sesión beta (p. ej. enlace desde el landing): minutos de demo en este navegador. 0 = sin límite.
COMFORT_LANDING_DEMO_MINUTES=10
# Solo aplica si COMFORT_ACCESS_MODE=beta: exige login (true) o permite probar sin cuenta y aplica solo la demo de arriba (false).
COMFORT_REQUIRE_BETA_LOGIN=true
COMFORT_DATA_DIR=
# Auditoría #15: bloqueos en disco entre procesos (proper-lockfile). true/1/yes para desactivar (solo FS raros; no usar con varios node).
COMFORT_DISABLE_FILE_LOCK=

# URL pública del sitio (opcional). Si la defines, coincide siempre con el dominio real (previews OG/canonical).
# Si está vacío, el servidor usa Host + X-Forwarded-Proto en cada petición.
COMFORT_PUBLIC_ORIGIN=

# --- Rate limits (auditoría #7) ---
# Máximo de POST /api/waitlist por dirección IP cada hora (anti-spam).
COMFORT_RATE_WAITLIST_MAX=1
# Máximo de consultas POST /api/ai-coach por usuario autenticado cada hora (además del límite mensual en memoria).
COMFORT_RATE_AI_COACH_HOURLY_MAX=5

# --- LemonSqueezy billing ---
# Crea una API key en https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
# ID numérico de tu tienda (Store → Settings)
LEMONSQUEEZY_STORE_ID=
# IDs de las dos variantes del producto "Comfort Ledger" (mensual y anual)
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_ANNUAL=
# Secreto del webhook (lo defines tú al crearlo en LemonSqueezy → Settings → Webhooks)
LEMONSQUEEZY_WEBHOOK_SECRET=
# A dónde redirige LemonSqueezy tras un pago exitoso (opcional). Ej: https://comfortledger.app/app
COMFORT_CHECKOUT_REDIRECT_URL=
# Pon "true" cuando estés listo para mostrar botones de compra en el landing.
# Si está en "false" o LemonSqueezy no está configurado, el landing solo capta waitlist.
COMFORT_PUBLIC_PURCHASE=false

# --- Web Push (VAPID) ---
# Genera el par con: npx web-push generate-vapid-keys
# Si alguno falta, el push del servidor queda deshabilitado (la app sigue funcionando sin avisos en segundo plano).
COMFORT_VAPID_PUBLIC_KEY=
COMFORT_VAPID_PRIVATE_KEY=
# Contacto VAPID (no envía emails; es metadata requerida por los push services)
COMFORT_VAPID_SUBJECT=mailto:support@comfortledger.app

# --- Soporte y branding ---
COMFORT_SUPPORT_EMAIL=support@comfortledger.app

# ─────────────────────────────────────────────────────────────────────────────
# CHECKLIST RÁPIDO — modo hybrid (pagado) listo para producción:
#
#  1. COMFORT_ACCESS_MODE=hybrid
#  2. Rellena LEMONSQUEEZY_API_KEY, STORE_ID, VARIANT_MONTHLY, WEBHOOK_SECRET
#  3. COMFORT_PUBLIC_PURCHASE=true  → activa botones de compra en el landing
#  4. COMFORT_CHECKOUT_REDIRECT_URL → tu URL de app tras pago
#  5. Registra webhook en LemonSqueezy → Settings → Webhooks:
#       URL: https://tudominio.com/api/webhooks/lemonsqueezy
#       Eventos: subscription_created, subscription_updated, subscription_cancelled,
#                subscription_resumed, subscription_expired, subscription_paused,
#                subscription_unpaused, subscription_payment_success,
#                subscription_payment_failed, subscription_payment_recovered
#  6. (Opcional) OPENAI_API_KEY → habilita el coach IA del servidor
#  7. node server.js
# ─────────────────────────────────────────────────────────────────────────────
